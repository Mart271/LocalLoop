  "autoApprove": true,
  "locations": { "inbox": { "kind": "folder", "access": "read" } },
  "permissions": { "operations": ["files.list"], "capabilityLevel": "basic" },
  "steps": [
    { "id": "list", "op": "files.list", "params": { "location": "inbox", "pattern": "*", "output": "documents" } }
  ],
  "successConditions": [{ "kind": "all_items_terminal" }]
}
