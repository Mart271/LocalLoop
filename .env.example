# LocalLoop — development-only environment overrides (PLANNED).
# No code reads these variables yet; they document intended developer settings.
# Release builds will ignore environment overrides.
#
# Never put secrets here. LocalLoop stores credentials only in the OS credential
# store (Windows Credential Manager, macOS Keychain). See SECURITY.md.

# Use a separate, git-ignored data folder during development instead of the
# per-user application data folder.
LOCALLOOP_DATA_DIR=./.localloop-dev

# Folder with development model files (*.gguf files are git-ignored).
LOCALLOOP_MODEL_DIR=./.localloop-dev/models

# Log level: error | warn | info | debug | trace
LOCALLOOP_LOG=info

# 1 = fail fast if any LocalLoop process attempts an outbound network connection
# during development and tests (supports NFR-007).
LOCALLOOP_STRICT_OFFLINE=1
